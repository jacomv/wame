# Admin API key — has full access to all instances (optional if using accounts only)
API_KEY=change-this-to-a-strong-secret-key

# Optional — defaults shown
PORT=3000
SESSION_DIR=./data/sessions
DATA_DIR=./data
RATE_LIMIT=100
SEND_RATE_LIMIT=30
CORS_ORIGIN=*

# Registro público de cuentas. Sin definir (recomendado): la primera cuenta se
# crea desde el panel y después el registro queda cerrado; solo el admin
# (x-api-key con API_KEY) puede crear más vía POST /auth/register.
#   true  → cualquiera puede registrarse (no recomendado si es accesible desde internet)
#   false → cerrado incluso para la primera cuenta (créala con la API_KEY de admin)
# ALLOW_REGISTRATION=

# Proxies de confianza para leer la IP real y el esquema (X-Forwarded-*).
# Sin definir = 1 (un proxy delante: Traefik, Dokploy, Nginx).
# Pon false si el puerto queda expuesto sin proxy: si no, un cliente puede
# falsificar X-Forwarded-For y saltarse el rate limit por IP.
# TRUST_PROXY=1

# Horas que se conserva un mensaje enviado para poder reenviarlo si el
# receptor no logra descifrarlo (evita "Esperando el mensaje"). Bajarlo
# reduce cuánto tiempo queda el contenido guardado en la base de datos.
MSG_CACHE_TTL_HOURS=24

# Comprobar si hay una versión nueva de WAME (GitHub) y de las dependencias
# (npm). Ponlo en false para que la instalación no haga ninguna llamada saliente.
UPDATE_CHECK=true

# Entregar al webhook 'messages' los mensajes de canales (newsletters).
# Apagado por omisión: una cuenta suele seguir decenas de canales de terceros y
# cada publicación dispararía el webhook. Publicar en canales funciona igual.
NEWSLETTER_INBOUND=false

# Nivel de log de Baileys. 'silent' por omisión porque en 'debug' es muy
# ruidoso. Súbelo a 'debug' para diagnosticar mensajes atascados en
# "Esperando el mensaje": los retry receipts y los fallos de descifrado los
# reporta Baileys, no WAME.
BAILEYS_LOG_LEVEL=silent

# Servidor MCP para asistentes de IA (OAuth 2.1). Apagado por omisión.
# PUBLIC_URL es la URL pública exacta del servidor: los clientes se conectan a
# <PUBLIC_URL>/mcp. Ver docs/MCP.md para los límites y el resto de opciones.
# MCP_ENABLED=true
# PUBLIC_URL=https://wame.example.com
